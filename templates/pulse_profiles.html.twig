<fieldset class="brandpulse-profile-selection border rounded p-3 {{ mode == 'profile' ? '' : 'd-none' }}" data-pulse-profile-access>
    <legend class="float-none w-auto px-2 fs-5">
        <i class="ti ti-list-check me-1" aria-hidden="true"></i>{{ __('Authorize specific profiles', 'brandpulse') }}
    </legend>
    {% if can_edit %}<input type="hidden" name="pulse_profile_selection_present" value="1" {% if mode != 'profile' %}disabled{% endif %}>{% endif %}
    {{ profile_dropdown|raw }}
    {% for name in readonly_profiles %}<span class="badge bg-secondary mt-2">{{ name }} — {{ __('Read only', 'brandpulse') }}</span>{% endfor %}
    <div class="form-text" data-pulse-profile-access-count data-label="{{ __('selected profiles', 'brandpulse') }}" aria-live="polite"></div>
    <p class="form-text mb-0">{{ __('Uses the native Display General Pulse permission. Save the Pulse configuration to apply this selection.', 'brandpulse') }}</p>
    {% if not can_edit %}<p class="text-muted mb-0">{{ __('You do not have permission to modify GLPI profiles.', 'brandpulse') }}</p>{% endif %}
</fieldset>
