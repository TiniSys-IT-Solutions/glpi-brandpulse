{
  "name": "tinisys-it-solutions/glpi-brandpulse",
  "description": "GLPI 12 branding and configurable header counters plugin.",
  "type": "glpi-plugin",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "TiniSys IT Solutions"
    }
  ],
  "require": {
    "php": ">=8.3",
    "ext-dom": "*",
    "ext-fileinfo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "GlpiPlugin\\Brandpulse\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "autoloader-suffix": "PluginBrandpulse"
  },
  "scripts": {
    "compile-translations": "php scripts/compile-translations.php",
    "test": "phpunit"
  }
}
